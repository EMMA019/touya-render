# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-cf/
/out/
.cf-hide/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# daily free-tier counters
/data/*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next-generated agent files
/AGENTS.md
/CLAUDE.md
/agent-tools/

# android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/

# Live2D Cubism Core is proprietary — do not commit the AAR or dropped-in SDK.
android/app/libs/*.aar
android/live2d/Core/
android/live2d/Framework/
android/live2d/Sample/
android/live2d/samples/
android/app/src/main/assets/live2d/**
!android/app/src/main/assets/live2d/
!android/app/src/main/assets/live2d/README.md
