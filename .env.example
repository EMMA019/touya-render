# DeepSeek — server only. Never expose this to the browser.
# Empty = no live model. Chat then uses canned demo replies unless TOUYA_DEMO=0.
DEEPSEEK_API_KEY=
# Cheap default. deepseek-chat is the non-reasoner chat model.
DEEPSEEK_MODEL=deepseek-chat

# Demo canned replies run ONLY when DEEPSEEK_API_KEY is empty.
# Unset: demo if the key is missing (local preview still works).
# 0: no demo — missing key returns 503.
# 1: does not override a live key. A set DEEPSEEK_API_KEY always uses DeepSeek.
TOUYA_DEMO=

# Local debug only. 1 = ignore the daily free chat cap (affinity + content gates stay on).
# Unset in production. UI shows a DEBUG marker when this is active.
TOUYA_DEBUG_UNLIMITED=

# Optional override. Default is ./data/usage.json (VPS-friendly).
USAGE_STORE_PATH=
# Sexual-escalation store. Default is ./data/sexual-strikes.json
SEXUAL_STORE_PATH=
# Per-user character memory. Default is ./data/memory.json
MEMORY_STORE_PATH=
# Per visitor×character affinity counts. Default is ./data/affinity.json
AFFINITY_STORE_PATH=
# Play Billing stub entitlements. Default is ./data/entitlements.json
ENTITLEMENTS_STORE_PATH=
# Pepper for hashing install UUIDs. Changing it resets quota counters.
TOUYA_ANON_PEPPER=

# Public AdMob flags only. Leave unit IDs empty until a reviewed account exists.
NEXT_PUBLIC_ADS_ENABLED=1
# NEXT_PUBLIC_ADMOB_APP_ID=
# NEXT_PUBLIC_ADMOB_BANNER_UNIT=
# NEXT_PUBLIC_ADMOB_REWARDED_UNIT=
