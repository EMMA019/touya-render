# OpenRouter — server only. NSFW mode uses this instead of DeepSeek.
# Missing key in NSFW returns 503. Never falls back to DeepSeek.
OPENROUTER_API_KEY=
# Default: nousresearch/hermes-3-llama-3.1-70b (low-refusal / roleplay catalog).
OPENROUTER_NSFW_MODEL=
# Default: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# DeepSeek — server only. Never expose this to the browser.
# Empty = no live model. Chat then uses canned demo replies unless TOUYA_DEMO=0.
DEEPSEEK_API_KEY=
# Cheap default. deepseek-chat is the non-reasoner chat model.
DEEPSEEK_MODEL=deepseek-chat

# Demo canned replies run ONLY when DEEPSEEK_API_KEY is empty.
# Unset: demo if the key is missing (local preview still works).
# 0: no demo — missing key returns 503.
# 1: does not override a live key. A set DEEPSEEK_API_KEY always uses DeepSeek.
TOUYA_DEMO=

# Personal / local: keep this at 1 in .env.local so there is no daily chat cap.
# Affinity and content gates stay on. Unset on a public production host.
TOUYA_DEBUG_UNLIMITED=1
# Same unlimited quota as TOUYA_DEBUG_UNLIMITED=1. Use for personal builds.
TOUYA_PERSONAL=

# Optional override. Default is ./data/usage.json (VPS-friendly).
USAGE_STORE_PATH=
# Sexual-escalation store. Default is ./data/sexual-strikes.json
SEXUAL_STORE_PATH=
# Per-user character memory. Default is ./data/memory.json
MEMORY_STORE_PATH=
# Per visitor×character affinity counts. Default is ./data/affinity.json
AFFINITY_STORE_PATH=
# Play Billing stub entitlements. Default is ./data/entitlements.json
ENTITLEMENTS_STORE_PATH=
# Pepper for hashing install UUIDs. Changing it resets quota counters.
TOUYA_ANON_PEPPER=
# Per-visitor age confirmation + chatMode (sfw|nsfw). Default ./data/visitors.json
VISITOR_STORE_PATH=
# JST login-day check-in (no currency). Default ./data/daily.json
DAILY_STORE_PATH=

# Browser origin of the Render API. Empty = same-origin (local / Render-hosted UI).
# Cloudflare Pages *build* must set this so the static UI calls Render:
# NEXT_PUBLIC_API_BASE=https://touya.onrender.com
NEXT_PUBLIC_API_BASE=

# Extra CORS origins for the Render API (comma-separated). `*` allows any.
# *.pages.dev / *.workers.dev / localhost / touya.onrender.com are already allowed.
# Add a custom Cloudflare domain here, e.g. https://touya.example.com
TOUYA_CORS_ORIGINS=

# Personal-use default: ads off. Set 1 only if you explicitly want AdMob slots.
NEXT_PUBLIC_ADS_ENABLED=0
# NEXT_PUBLIC_ADMOB_APP_ID=
# NEXT_PUBLIC_ADMOB_BANNER_UNIT=
# NEXT_PUBLIC_ADMOB_REWARDED_UNIT=
